{
  "name": "twake-sessions-service",
  "version": "0.1.0",
  "description": "Ends a user's LemonLDAP::NG sessions when a RabbitMQ message names that user",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "start": "node dist/index.js",
    "dev": "tsx --env-file=.env src/index.ts"
  },
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@linagora/rabbitmq-client": "0.3.1",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.30",
    "eslint": "^10.11.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.8"
  }
}
